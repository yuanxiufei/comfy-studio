# ══════════════════════════════════════════════════════════════
#  AI漫剧资产库Agent · 忽略清单
# ══════════════════════════════════════════════════════════════

# ── 密钥：绝不入库 ──
.env
.env.local

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 生成物：整个 output/ 都是派生产物，不入库 ──
#   images/   图像（体积大）· prompts/ 提示词（可由资产卡 + 规则重算）
#   metadata/ 元数据 · previews/ 预览
# 单一来源是 `assets/` 里的资产卡 —— 提示词与图像都能从中重建。
# 跨电脑迁移用 `python main.py export` 打 ZIP。
output/
*.zip

# ── 规则快照：**故意不入库** ──
# 快照是工作流规则的副本，入库会造成「同一知识两处维护」，违背工作流
# 质量守则 §2「单一权威来源」。需要独立迁移时用 `python main.py export --snapshot`
# 现场生成；有工作流目录时一律实时读取（live 模式）。
vendor/

# ── 系统文件 ──
.DS_Store
Thumbs.db
