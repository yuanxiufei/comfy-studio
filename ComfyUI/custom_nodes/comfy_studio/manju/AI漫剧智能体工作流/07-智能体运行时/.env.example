# ══════════════════════════════════════════════════════════════
#  AI漫剧资产库Agent · 环境变量样例
# ══════════════════════════════════════════════════════════════
#
#  用法：复制为 .env 并填入真实值。
#        .env 已在 .gitignore 中 —— **绝不要把 Key 提交进 Git**
#        （蓝图 §二十一：不要写入 SYSTEM_PROMPT.md / config.json /
#          README.md / 源码 / Markdown / JSON）。
#
#  ⚠️ 全部留空也能运行：规则解析 + mock 占位图，端到端跑通。
#     填了才升级为真实语义解析与真实出图。
#
#  Python 默认不自动读 .env。两种加载方式：
#    ① 直接设为系统环境变量（推荐，最省事）
#    ② 安装 python-dotenv 并在调用前 load_dotenv()
# ══════════════════════════════════════════════════════════════

# ── LLM（语义解析 + 视觉精修，可选）──────────────────────────
# 任何兼容 POST {base_url}/chat/completions 的服务都可以
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 常用替代（三选一，按你的账号改）：
#   DeepSeek   MODEL_BASE_URL=https://api.deepseek.com/v1          MODEL_NAME=deepseek-chat
#   智谱 GLM   MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4 MODEL_NAME=glm-4-flash
#   Ollama 本地 MODEL_BASE_URL=http://localhost:11434/v1           MODEL_NAME=qwen2.5

# ── 图像生成（可选）──────────────────────────────────────────
# provider 在 config.json 的 image.provider 里选：mock / openai / stability
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# 常用替代：
#   智谱 CogView  IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4  IMAGE_MODEL=cogview-3-flash
#   Stability     IMAGE_BASE_URL=https://api.stability.ai              IMAGE_MODEL=core

# ── 工作流定位（可选）────────────────────────────────────────
# 本项目默认自动向上查找工作流目录；跨机器迁移或目录变动时在此指定绝对路径
# WORKFLOW_ROOT=D:\code\voides\agent\AI漫剧智能体工作流
