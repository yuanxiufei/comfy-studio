{
  "name": "comfy-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ComfyUI（引擎）+ Comfy-Desktop（桌面壳）打通成的工作台",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File setup/install-engine.ps1",
    "setup:desktop": "pnpm --dir Comfy-Desktop install",
    "setup:all": "npm run setup && npm run setup:desktop",
    "seed": "node setup/seed-desktop.mjs",
    "dev": "npm run seed && pnpm --dir Comfy-Desktop dev",
    "engine": "node setup/run-engine.mjs",
    "engine:help": "node setup/run-engine.mjs --help",
    "mcp": "node setup/run-mcp.mjs",
    "studio": "node setup/run-studio.mjs",
    "doctor": "node setup/doctor.mjs",
    "clear:web-cache": "node setup/clear-web-cache.mjs"
  }
}
